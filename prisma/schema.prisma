generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoleName {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum MembershipCode {
  STANDARD
  PRO_PLAYER
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum TableStatus {
  AVAILABLE
  IN_USE
  RESERVED
  MAINTENANCE
}

enum GameStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE_PAYMENT
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        RoleName         @unique
  description String?
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(100)
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("permissions")
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id               String        @id @default(uuid()) @db.Uuid
  email            String        @unique @db.VarChar(255)
  passwordHash     String        @db.VarChar(255)
  firstName        String        @db.VarChar(100)
  lastName         String        @db.VarChar(100)
  phone            String?       @db.VarChar(30)
  status           UserStatus    @default(ACTIVE)
  roleId           String        @db.Uuid
  role             Role          @relation(fields: [roleId], references: [id], onDelete: Restrict)
  lastLoginAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?
  membersCreated   Member[]      @relation("MemberCreatedBy")
  membersUpdated   Member[]      @relation("MemberUpdatedBy")
  gamesCreated     GameSession[] @relation("GameCreatedBy")
  gamesEnded       GameSession[] @relation("GameEndedBy")
  paymentsReceived Payment[]     @relation("PaymentReceivedBy")
  expensesCreated  Expense[]     @relation("ExpenseCreatedBy")
  expensesUpdated  Expense[]     @relation("ExpenseUpdatedBy")
  settingsUpdated  ClubSetting[] @relation("SettingUpdatedBy")
  auditLogs        AuditLog[]

  @@index([status, deletedAt])
  @@map("users")
}

model MembershipType {
  id              String         @id @default(uuid()) @db.Uuid
  code            MembershipCode @unique
  name            String         @db.VarChar(100)
  discountPercent Decimal        @default(0) @db.Decimal(5, 2)
  isActive        Boolean        @default(true)
  members         Member[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("membership_types")
}

model Member {
  id               String         @id @default(uuid()) @db.Uuid
  membershipNumber String         @unique @db.VarChar(30)
  name             String         @db.VarChar(150)
  fatherName       String?        @db.VarChar(150)
  photoUrl         String?        @db.VarChar(500)
  phone            String?        @db.VarChar(30)
  email            String?        @unique @db.VarChar(255)
  address          String?
  membershipTypeId String         @db.Uuid
  membershipType   MembershipType @relation(fields: [membershipTypeId], references: [id], onDelete: Restrict)
  status           MemberStatus   @default(ACTIVE)
  startDate        DateTime       @default(now()) @db.Date
  endDate          DateTime?      @db.Date
  createdById      String         @db.Uuid
  createdBy        User           @relation("MemberCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById      String         @db.Uuid
  updatedBy        User           @relation("MemberUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  games            GameSession[]
  payments         Payment[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?

  @@index([name])
  @@index([status, deletedAt])
  @@index([membershipTypeId])
  @@map("members")
}

model SnookerTable {
  id                 String        @id @default(uuid()) @db.Uuid
  number             Int           @unique
  name               String        @db.VarChar(80)
  status             TableStatus   @default(AVAILABLE)
  hourlyRateOverride Decimal?      @db.Decimal(12, 2)
  gameSessions       GameSession[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([status])
  @@map("snooker_tables")
}

model GameSession {
  id                      String         @id @default(uuid()) @db.Uuid
  code                    String         @unique @db.VarChar(40)
  tableId                 String         @db.Uuid
  table                   SnookerTable   @relation(fields: [tableId], references: [id], onDelete: Restrict)
  memberId                String         @db.Uuid
  member                  Member         @relation(fields: [memberId], references: [id], onDelete: Restrict)
  status                  GameStatus     @default(IN_PROGRESS)
  startTime               DateTime
  endTime                 DateTime?
  durationSeconds         Int?
  hourlyRateSnapshot      Decimal        @db.Decimal(12, 2)
  membershipCodeSnapshot  MembershipCode
  discountPercentSnapshot Decimal        @db.Decimal(5, 2)
  baseAmount              Decimal?       @db.Decimal(12, 2)
  discountAmount          Decimal?       @db.Decimal(12, 2)
  finalAmount             Decimal?       @db.Decimal(12, 2)
  paymentStatus           PaymentStatus  @default(PENDING)
  createdById             String         @db.Uuid
  createdBy               User           @relation("GameCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  endedById               String?        @db.Uuid
  endedBy                 User?          @relation("GameEndedBy", fields: [endedById], references: [id], onDelete: Restrict)
  payment                 Payment?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  @@index([status, startTime])
  @@index([tableId, status])
  @@index([memberId, startTime])
  @@map("game_sessions")
}

model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  receiptNumber String        @unique @db.VarChar(50)
  gameId        String?       @unique @db.Uuid
  game          GameSession?  @relation(fields: [gameId], references: [id], onDelete: Restrict)
  memberId      String?       @db.Uuid
  member        Member?       @relation(fields: [memberId], references: [id], onDelete: Restrict)
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  status        PaymentStatus @default(PAID)
  paymentDate   DateTime      @default(now())
  receivedById  String        @db.Uuid
  receivedBy    User          @relation("PaymentReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)
  reference     String?       @db.VarChar(120)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([paymentDate])
  @@index([memberId, paymentDate])
  @@index([status])
  @@map("payments")
}

model ExpenseCategory {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique @db.VarChar(100)
  description String?
  isActive    Boolean   @default(true)
  expenses    Expense[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("expense_categories")
}

model Expense {
  id            String          @id @default(uuid()) @db.Uuid
  title         String          @db.VarChar(180)
  categoryId    String          @db.Uuid
  category      ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  amount        Decimal         @db.Decimal(12, 2)
  expenseDate   DateTime        @db.Date
  paymentMethod PaymentMethod
  vendor        String?         @db.VarChar(180)
  description   String?
  receiptUrl    String?         @db.VarChar(500)
  reference     String?         @db.VarChar(120)
  isRecurring   Boolean         @default(false)
  createdById   String          @db.Uuid
  createdBy     User            @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById   String          @db.Uuid
  updatedBy     User            @relation("ExpenseUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([expenseDate])
  @@index([categoryId, expenseDate])
  @@index([createdById])
  @@map("expenses")
}

model ClubSetting {
  id                String   @id @default("default") @db.VarChar(30)
  clubName          String   @default("Kabul Snooker Club") @db.VarChar(150)
  currency          String   @default("AFN") @db.VarChar(3)
  defaultHourlyRate Decimal  @default(100) @db.Decimal(12, 2)
  timezone          String   @default("Asia/Kabul") @db.VarChar(60)
  updatedById       String?  @db.Uuid
  updatedBy         User?    @relation("SettingUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("club_settings")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String?  @db.Uuid
  actor        User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action       String   @db.VarChar(100)
  resourceType String   @db.VarChar(80)
  resourceId   String?  @db.VarChar(80)
  before       Json?
  after        Json?
  ipAddress    String?  @db.VarChar(64)
  userAgent    String?  @db.VarChar(500)
  createdAt    DateTime @default(now())

  @@index([resourceType, resourceId])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}
